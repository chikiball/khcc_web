# --- Database (Postgres in Docker) ---
POSTGRES_USER=khcc
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=khcc

# DATABASE_URL is only needed for local NON-Docker development (npm run dev
# pointing at a Postgres on localhost). In Docker, the app reads PG* env
# vars directly from docker-compose to avoid URL-encoding pitfalls in the
# password (chars like +, /, = break the URL form).
DATABASE_URL=postgres://khcc:change-me-to-something-long-and-random@localhost:5432/khcc

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret

# Google OAuth credentials — Google Cloud Console → APIs & Services → Credentials
# Authorised redirect URI:
#   Local:  http://localhost:3000/api/auth/callback/google
#   Prod:   https://khcc.nandharu.uk/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Public site URL — used by Auth.js to build OAuth callback URLs
# Local: http://localhost:3000   Prod: https://khcc.nandharu.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000
