# Supabase Cloud project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — server-only, never exposed to the browser. Used by admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used to build OAuth redirect URIs and absolute links.
# Local: http://localhost:3000   Prod: https://khcc.nandharu.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000
