# --- Database (Postgres in Docker) ---
POSTGRES_USER=burkam
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=burkam

# DATABASE_URL is only needed for local NON-Docker development (npm run dev
# pointing at a Postgres on localhost). In Docker, the app reads PG* env
# vars directly from docker-compose to avoid URL-encoding pitfalls in the
# password (chars like +, /, = break the URL form).
DATABASE_URL=postgres://burkam:change-me-to-something-long-and-random@localhost:5432/burkam

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret

# Google OAuth credentials — Google Cloud Console → APIs & Services → Credentials
# Authorised redirect URI:
#   Local:  http://localhost:3000/api/auth/callback/google
#   Prod:   https://burkam.nandharu.uk/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Public site URL — used by Auth.js to build OAuth callback URLs
# Local: http://localhost:3000   Prod: https://burkam.nandharu.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SMTP (Brevo / Sendinblue — free tier covers ~300 emails/day) ---
# 1. Sign up at https://www.brevo.com and verify burkam.nandharu.uk as a
#    sender domain. Brevo will give you SPF + DKIM DNS records to add at
#    your DNS provider (Cloudflare, etc).
# 2. Generate an SMTP key: Brevo dashboard → SMTP & API → SMTP → Generate.
# 3. Copy the SMTP login (your Brevo account email) and key below.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key
# Display from address — use any address @burkam.nandharu.uk once the
# domain is verified in Brevo. The address does NOT need to exist as an
# inbox; Brevo just signs the outgoing mail with your DKIM key.
SMTP_FROM="Burkam <noreply@burkam.nandharu.uk>"

# --- Map tiles (Mapbox) ---
# Get a public token at https://account.mapbox.com/access-tokens/
# Free tier: 50k map loads + 200k tile requests / month.
# Restrict the token to https://burkam.nandharu.uk/* in the Mapbox dashboard
# since it ships in the client JS bundle. Falls back to OSM tiles if unset.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...your-token-here

# --- Cron secret ---
# Protects /api/cron/materialize-rides from arbitrary callers.
# Generate with: openssl rand -hex 20
# Add to crontab: 0 19 * * 6 curl -s "https://burkam.nandharu.uk/api/cron/materialize-rides?secret=<value>" >> /var/log/burkam-cron.log 2>&1
CRON_SECRET=replace-with-a-random-secret
# Keeps server-action IDs stable across deploys so open browser tabs do
# not error out with "Failed to find Server Action" after a redeploy.
# Generate once with: openssl rand -base64 32
# Treat as a secret; rotating it logs all open client tabs out of any
# in-flight server action calls (they retry fine on the next interaction).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret
